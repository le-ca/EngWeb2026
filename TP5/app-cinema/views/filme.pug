extends layout 

block content
  .w3-card-4 
    header.w3-container.w3-teal
      h2= filme.title 
    .w3-container.w3-margin-top 
      p #[b ID:]  filme.id
      p #[b Ano:] #{filme.year}

      .w3-row-padding.w3-margin-top 
        .w3-half 
          h4 Atores 
          ul.w3-ul.w3-border 
            if filme.cast && filme.cast.length > 0
              each ator in filme.cast 
                li 
                  a(href=`/atores/${ator}`)= ator 
            else 
              li Sem atores registados.

        .w3-half 
          h4 Géneros 
          ul.w3-ul.w3-border 
            if filme.genres && filme.genres.length > 0
              each genero in filme.genres 
                li 
                  a(href=`/generos/${genero}`)= genero 
            else 
              li Sem géneros registados.

    footer.w3-container.w3-teal.w3-padding-16.w3-margin-top 
      a.w3-button.w3-white(href="/filmes") Voltar à Lista             
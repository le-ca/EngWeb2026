extends layout 

block content
  .w3-card-4 
    header.w3-container.w3-indigo
      h2 Ator: #{ator}
    .w3-container.w3-padding-16 
      h4 Participou nos seguintes filmes: 
      ul.w3-ul.w3-border 
        each f in filmes 
          li.w3-hover-light-grey(onclick=`window.location='/filmes/${f.id}'` style="cursor: pointer;")
            | #{f.title} (#{f.year})
    footer.w3-container.w3-indigo.w3-padding-16 
      a.w3-button.w3-white(href="/atores") Voltar aos Atores            
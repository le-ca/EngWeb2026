extends layout 

block content
  .w3-card-4 
    header.w3-container.w3-deep-purple
      h2 Género: #{genero}
    .w3-container.w3-padding-16 
      h4 Filmes deste género: 
      ul.w3-ul.w3-border 
        each f in filmes 
          li.w3-hover-light-grey(onclick=`window.location='/filmes/${f.id}'` style="cursor: pointer;")
            | #{f.title} (#{f.year})
    footer.w3-container.w3-deep-purple.w3-padding-16 
      a.w3-button.w3-white(href="/generos") Voltar aos Géneros            
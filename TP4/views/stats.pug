extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Estatísticas EMD
      
    // Lógica simples de cálculo in-line (Pug permite JS básico)
    - var total = list.length
    - var aptos = list.filter(e => e.resultado).length
    - var federados = list.filter(e => e.federado).length
    - var generos = {"M": 0, "F": 0}
    - list.forEach(e => { generos[e.género] = (generos[e.género] || 0) + 1 })
    
    .w3-container
        table.w3-table-all
            tr
                th Total Registos
                td= total
            tr
                th Aptos
                td= aptos + " (" + Math.round((aptos/total)*100) + "%)"
            tr
                th Federados
                td= federados
            tr
                th Género Feminino
                td= generos["F"]
            tr
                th Género Masculino
                td= generos["M"]

    footer.w3-container.w3-teal.w3-margin-top
      address 
        a.w3-button.w3-white.w3-margin(href="/") Voltar
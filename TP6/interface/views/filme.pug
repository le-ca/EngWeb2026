extends layout
block content
  div.w3-card-4.w3-margin
    header.w3-container.w3-indigo
      h2= filme.title
    div.w3-container
      p #[b Ano:] #{filme.year}
      p #[b Elenco:] #{filme.cast.join(', ')}
      p #[b Géneros:] #{filme.genres.join(', ')}
    footer.w3-container.w3-light-grey.w3-padding
      a.w3-button.w3-indigo(href='/filmes') Voltar